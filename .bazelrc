# Java language level for Android compatibility
build --java_language_version=11
build --java_runtime_version=11

# Proto toolchain resolution
build --incompatible_enable_proto_toolchain_resolution

# Test output settings
test --test_output=errors

# Disk cache for local builds
build --disk_cache=~/.cache/bazel-disk

# CI config: let setup-bazel manage the disk cache
build:ci --disk_cache=

# Verbose failures for debugging
build --verbose_failures

# Suppress warnings from external C++ deps (protobuf, gRPC, abseil)
build --per_file_copt=external/.*@-w

# Suppress duplicate library linker warnings (macOS)
build --linkopt=-Wl,-no_warn_duplicate_libraries

# Disable C++ module checks that fail with Xcode SDK (bazelbuild/bazel#24556)
build --features=-layering_check
build --host_features=-layering_check

# CI remote cache — activated by --config=ci
# setup-bazel disk-cache + repository-cache + external-cache already persist
# across GHA runs. For a full Bazel remote cache, add a BAZEL_REMOTE_CACHE_URL
# repo secret (e.g. https://storage.googleapis.com/<bucket> or
# grpcs://remote.buildbuddy.io) and CI will pass --remote_cache automatically.
build:ci --remote_accept_cached
build:ci --remote_upload_local_results

# CI resource tuning — GitHub-hosted ubuntu runners have 4 vCPUs / 16 GB RAM
build:ci --jobs=auto
build:ci --local_ram_resources=HOST_RAM*.8
build:ci --local_cpu_resources=HOST_CPUS
