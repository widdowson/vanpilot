# Emulator-based golden test — requires a running emulator.
# Tagged "manual" so it does NOT run during bazel test //...
# Tagged "exclusive" so only one runs at a time (emulator is resource-heavy).
#
# Usage:
#   bazel test //goldens:emulator_golden_test \
#     --test_env=EMU_HOST=localhost --test_env=EMU_PORT=5555
py_test(
    name = "emulator_golden_test",
    srcs = ["test_emulator_golden.py"],
    main = "test_emulator_golden.py",
    imports = [".."],
    data = glob(
        ["phase9/*.png"],
        allow_empty = True,
    ),
    deps = [
        ":golden_diff",
        ":video_capture",
    ],
    size = "large",
    tags = [
        "exclusive",
        "manual",
    ],
    timeout = "long",
)

