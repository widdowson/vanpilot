load("@pip//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")

package(default_visibility = ["//visibility:public"])

# ============================================================================
# Filegroups
# ============================================================================

filegroup(
    name = "phase3_goldens",
    srcs = ["//goldens/phase3:golden_images"],
)

# ============================================================================
# Libraries
# ============================================================================

py_library(
    name = "golden_diff",
    srcs = ["golden_diff.py"],
    imports = [".."],
    deps = ["//mcp:png_util"],
)

py_library(
    name = "capture_emulator_lib",
    srcs = ["capture_emulator.py"],
    imports = [".."],
)

py_library(
    name = "video_capture",
    srcs = ["video_capture.py"],
    imports = [".."],
)

py_library(
    name = "golden_test_harness",
    srcs = ["golden_test_harness.py"],
    imports = [".."],
    deps = [
        ":golden_diff",
        "//proto/vanpilot/v1:instance_manager_py_proto",
        requirement("grpcio"),
    ],
)

# ============================================================================
# Binaries
# ============================================================================

py_binary(
    name = "generate_goldens",
    srcs = ["generate_goldens.py"],
    main = "generate_goldens.py",
    imports = [".."],
    deps = ["//mcp:png_util"],
)

py_binary(
    name = "capture_golden",
    srcs = ["capture_emulator.py"],
    main = "capture_emulator.py",
    imports = [".."],
)

py_binary(
    name = "capture_all",
    srcs = ["capture_all.py"],
    main = "capture_all.py",
    imports = [".."],
    deps = [
        ":golden_test_harness",
        requirement("grpcio"),
    ],
)

