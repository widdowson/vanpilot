load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")

package(default_visibility = ["//visibility:public"])

# ============================================================================
# Filegroups
# ============================================================================

filegroup(
    name = "phase3_goldens",
    srcs = ["//goldens/phase3:golden_images"],
)

# ============================================================================
# Libraries
# ============================================================================

py_library(
    name = "video_capture",
    srcs = ["video_capture.py"],
    imports = [".."],
)

# ============================================================================
# Binaries
# ============================================================================

py_binary(
    name = "generate_goldens",
    srcs = ["generate_goldens.py"],
    main = "generate_goldens.py",
    imports = [".."],
    deps = ["//mcp:png_util"],
)

# ============================================================================
# Tests — fine-grained, one per test module
# ============================================================================

py_test(
    name = "solid_color_surface_test",
    srcs = ["test_solid_color_surface.py"],
    main = "test_solid_color_surface.py",
    imports = [".."],
    data = [":phase3_goldens"],
    deps = ["//mcp:png_util"],
)

py_test(
    name = "video_capture_config_test",
    srcs = ["test_video_capture.py"],
    main = "test_video_capture.py",
    imports = [".."],
    args = ["VideoCaptureConfigTest"],
    deps = [":video_capture"],
)

py_test(
    name = "video_capture_disabled_test",
    srcs = ["test_video_capture.py"],
    main = "test_video_capture.py",
    imports = [".."],
    args = ["VideoCaptureDisabledTest"],
    deps = [":video_capture"],
)

py_test(
    name = "video_capture_enabled_test",
    srcs = ["test_video_capture.py"],
    main = "test_video_capture.py",
    imports = [".."],
    args = ["VideoCaptureEnabledTest"],
    deps = [":video_capture"],
)

py_test(
    name = "video_capture_duration_test",
    srcs = ["test_video_capture.py"],
    main = "test_video_capture.py",
    imports = [".."],
    args = ["VideoCaptureConfigCustomDurationTest"],
    deps = [":video_capture"],
)
