# Emulator-based golden test — requires a running emulator.
# Tagged "manual" so it does NOT run during bazel test //...
# Tagged "exclusive" so only one runs at a time (emulator is resource-heavy).
#
# Usage:
#   bazel test //goldens:emulator_golden_test \
#     --test_env=EMU_HOST=localhost --test_env=EMU_PORT=5555
py_test(
    name = "emulator_golden_test",
    srcs = ["test_emulator_golden.py"],
    main = "test_emulator_golden.py",
    imports = [".."],
    data = glob(
        ["phase9/*.png"],
        allow_empty = True,
    ),
    deps = [
        ":display_profiles",
        ":golden_diff",
        ":video_capture",
    ],
    size = "large",
    tags = [
        "exclusive",
        "manual",
    ],
    timeout = "long",
)

# 13-inch automotive display golden test (AC-10.2).
# Uses 1920x720 ultrawide DHU resolution matching 13" head units.
# Goldens live in goldens/13inch/.
#
# Usage:
#   bazel test //goldens:emulator_golden_13inch_test \
#     --test_env=EMU_HOST=localhost --test_env=EMU_PORT=5555
py_test(
    name = "emulator_golden_13inch_test",
    srcs = ["test_emulator_golden.py"],
    main = "test_emulator_golden.py",
    imports = [".."],
    data = glob(
        ["13inch/*.png"],
        allow_empty = True,
    ),
    env = {"DISPLAY_PROFILE": "13inch"},
    deps = [
        ":display_profiles",
        ":golden_diff",
        ":video_capture",
    ],
    size = "large",
    tags = [
        "exclusive",
        "manual",
    ],
    timeout = "long",
)

