load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")

package(default_visibility = ["//visibility:public"])

# ============================================================================
# Golden image filegroups
# ============================================================================

filegroup(
    name = "phase3_goldens",
    srcs = ["//goldens/phase3:golden_images"],
)

# ============================================================================
# Libraries
# ============================================================================

py_library(
    name = "golden_diff",
    srcs = ["golden_diff.py"],
    imports = [".."],
    deps = ["//mcp:png_util"],
)

py_library(
    name = "capture_emulator_lib",
    srcs = ["capture_emulator.py"],
    imports = [".."],
)

# ============================================================================
# Binaries
# ============================================================================

py_binary(
    name = "generate_goldens",
    srcs = ["generate_goldens.py"],
    main = "generate_goldens.py",
    imports = [".."],
    deps = ["//mcp:png_util"],
)

py_binary(
    name = "capture_golden",
    srcs = ["capture_emulator.py"],
    main = "capture_emulator.py",
    imports = [".."],
)

# ============================================================================
# Tests — fine-grained, one per test module
# ============================================================================

py_test(
    name = "solid_color_surface_test",
    srcs = ["test_solid_color_surface.py"],
    main = "test_solid_color_surface.py",
    imports = [".."],
    data = [":phase3_goldens"],
    deps = ["//mcp:png_util"],
)

py_test(
    name = "golden_diff_test",
    srcs = ["test_golden_diff.py"],
    main = "test_golden_diff.py",
    imports = [".."],
    deps = [
        ":golden_diff",
        "//mcp:png_util",
    ],
)

# Emulator-based golden test — requires a running emulator sidecar.
# Tagged "manual" so it does NOT run during bazel test //...
# Tagged "exclusive" so only one runs at a time (emulator is resource-heavy).
#
# Usage:
#   bazel test //goldens:emulator_golden_test \
#     --test_env=EMU_HOST=localhost --test_env=EMU_PORT=5555
py_test(
    name = "emulator_golden_test",
    srcs = ["test_emulator_golden.py"],
    main = "test_emulator_golden.py",
    imports = [".."],
    data = glob(
        ["phase9/*.png"],
        allow_empty = True,
    ),
    deps = [":golden_diff"],
    size = "large",
    tags = [
        "exclusive",
        "manual",
    ],
    timeout = "long",
)
