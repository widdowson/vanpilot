load("@pip//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_library", "py_test")

package(default_visibility = ["//visibility:public"])

# ============================================================================
# Libraries
# ============================================================================

py_library(
    name = "event_store",
    srcs = ["src/event_store.py"],
    imports = [".."],
    deps = [
        "//proto/vanpilot/v1:sync_py_proto",
    ],
)

py_library(
    name = "mcp_bridge",
    srcs = ["src/mcp_bridge.py"],
    imports = [".."],
    deps = [
        ":event_store",
        "//proto/vanpilot/v1:sync_py_proto",
    ],
)

py_library(
    name = "tmux_launcher",
    srcs = ["src/tmux_launcher.py"],
    imports = [".."],
)

py_library(
    name = "input_injector",
    srcs = ["src/input_injector.py"],
    imports = [".."],
    deps = [
        ":event_store",
        ":tmux_launcher",
        "//proto/vanpilot/v1:sync_py_proto",
    ],
)

py_library(
    name = "sync_service",
    srcs = ["src/sync_service.py"],
    imports = [".."],
    deps = [
        ":event_store",
        ":input_injector",
        ":mcp_bridge",
        "//proto/vanpilot/v1:sync_py_proto",
        requirement("grpcio"),
    ],
)

py_library(
    name = "watchdog",
    srcs = ["src/watchdog.py"],
    imports = [".."],
    deps = [
        ":event_store",
        "//proto/vanpilot/v1:sync_py_proto",
