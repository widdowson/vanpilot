)

py_library(
    name = "android_app_client",
    srcs = ["src/android_app_client.py"],
    imports = [".."],
    deps = [
        "//proto/vanpilot/v1:screenshot_py_proto",
        requirement("grpcio"),
    ],
)

py_library(
    name = "server",
    srcs = ["src/server.py"],
    imports = [".."],
    deps = [
        ":android_app_client",
        ":event_store",
        ":log_tailer",
        ":mcp_bridge",
        ":sync_service",
        requirement("grpcio"),
    ],
)

