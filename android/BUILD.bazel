load("@rules_kotlin//kotlin:android.bzl", "kt_android_library")
load("@rules_kotlin//kotlin:jvm.bzl", "kt_jvm_library")
load("@rules_android//rules:rules.bzl", "android_binary")

package(default_visibility = ["//visibility:public"])

# ============================================================================
# Voice I/O library (STT, TTS, state machine)
# ============================================================================

kt_android_library(
    name = "voice_lib",
    srcs = glob(["app/src/main/kotlin/com/vanpilot/auto/voice/**/*.kt"]),
    custom_package = "com.vanpilot.auto",
    manifest = "app/src/main/AndroidManifest.xml",
    deps = [
        "@maven//:org_jetbrains_kotlinx_kotlinx_coroutines_core",
    ],
)

# ============================================================================
# Connectivity primitives (ConnectionState, ConnectionMonitor — no proto deps)
# ============================================================================

kt_jvm_library(
    name = "connectivity_lib",
    srcs = [
        "app/src/main/kotlin/com/vanpilot/auto/connectivity/ConnectionMonitor.kt",
        "app/src/main/kotlin/com/vanpilot/auto/connectivity/ConnectionState.kt",
    ],
)

# Cache library (BitmapCache + DisplayHistory — no Android/gRPC deps)
# ============================================================================

kt_jvm_library(
    name = "cache_lib",
    srcs = glob(["app/src/main/kotlin/com/vanpilot/auto/cache/**/*.kt"]),
)

# ============================================================================
# Main app library (Car App UI — no gRPC deps to avoid dex issues)
# ============================================================================

kt_android_library(
    name = "vanpilot_lib",
    srcs = glob(
        ["app/src/main/kotlin/**/*.kt"],
        exclude = [
            "app/src/main/kotlin/com/vanpilot/auto/voice/**/*.kt",
            "app/src/main/kotlin/com/vanpilot/auto/grpc/**",
            "app/src/main/kotlin/com/vanpilot/auto/cache/**",
            "app/src/main/kotlin/com/vanpilot/auto/sync/**",
            "app/src/main/kotlin/com/vanpilot/auto/connectivity/**",
        ],
    ),
    custom_package = "com.vanpilot.auto",
    manifest = "app/src/main/AndroidManifest.xml",
    resource_files = glob(["app/src/main/res/**"]),
    deps = [
        ":cache_lib",
        ":connectivity_lib",
        ":grpc_endpoint_lib",
        ":voice_lib",
        "@maven//:androidx_car_app_app",
        "@maven//:androidx_fragment_fragment",
    ],
)

# ============================================================================
# Lightweight gRPC endpoint config (no proto deps — safe for android_binary)
#
# Contains only GrpcEndpointConfig and ChannelFactory. These classes
# depend on io.grpc types but NOT on generated proto code, so they can
# be pulled into vanpilot_lib without triggering the dex .jar error.
# ============================================================================
kt_jvm_library(
    name = "grpc_endpoint_lib",
    srcs = [
        "app/src/main/kotlin/com/vanpilot/auto/grpc/GrpcEndpointConfig.kt",
        "app/src/main/kotlin/com/vanpilot/auto/grpc/ChannelFactory.kt",
    ],
    deps = [
        "@maven//:io_grpc_grpc_stub",
    ],
)

# ============================================================================
# gRPC client/server library (JVM-only — no Android API usage)
#
# SyncClient.kt is excluded because it uses Android APIs (Bitmap,
# BitmapFactory) and must be in an android_library target instead.
# GrpcEndpointConfig and ChannelFactory live in grpc_endpoint_lib above.
# ============================================================================
kt_jvm_library(
    name = "grpc_lib",
    srcs = glob(
        [
            "app/src/main/kotlin/com/vanpilot/auto/grpc/**/*.kt",
            "app/src/main/kotlin/com/vanpilot/auto/sync/**/*.kt",
            "app/src/main/kotlin/com/vanpilot/auto/connectivity/**/*.kt",
        ],
        exclude = [
            "app/src/main/kotlin/com/vanpilot/auto/grpc/SyncClient.kt",
            "app/src/main/kotlin/com/vanpilot/auto/grpc/GrpcEndpointConfig.kt",
            "app/src/main/kotlin/com/vanpilot/auto/grpc/ChannelFactory.kt",
            "app/src/main/kotlin/com/vanpilot/auto/connectivity/ConnectionMonitor.kt",
            "app/src/main/kotlin/com/vanpilot/auto/connectivity/ConnectionState.kt",
        ],
    ),
    deps = [
        ":cache_lib",
        ":connectivity_lib",
        ":grpc_endpoint_lib",
        "//proto/vanpilot/v1:sync_java_proto",
        "//proto/vanpilot/v1:sync_java_grpc",
        "//proto/vanpilot/v1:screenshot_java_proto",
        "//proto/vanpilot/v1:screenshot_java_grpc",
        "@maven//:io_grpc_grpc_stub",
        "@maven//:io_grpc_grpc_protobuf_lite",
    ],
)

# ============================================================================
# SyncClient library (Android — uses Bitmap/BitmapFactory)
#
# Separate from vanpilot_lib to keep proto/gRPC .jar deps out of the
# android_binary dex path. Only used by tests for now; will be wired
# into the production app when the full integration is complete.
# ============================================================================

kt_android_library(
    name = "sync_client_lib",
    srcs = ["app/src/main/kotlin/com/vanpilot/auto/grpc/SyncClient.kt"],
    custom_package = "com.vanpilot.auto",
    manifest = "app/src/main/AndroidManifest.xml",
    deps = [
        ":vanpilot_lib",
        "@maven//:io_grpc_grpc_stub",
        "@maven//:io_grpc_grpc_protobuf_lite",
        "//proto/vanpilot/v1:sync_java_proto",
        "//proto/vanpilot/v1:sync_java_grpc",
    ],
)

# ============================================================================
# App binary (APK)
#
# Debug-signed by default using the committed debug keystore.
# For release builds, use the :vanpilot_release_apk genrule.
# ============================================================================

android_binary(
    name = "vanpilot",
    custom_package = "com.vanpilot.auto",
    debug_key = "//android/keystores:debug.keystore",
    manifest = "app/src/main/AndroidManifest.xml",
    multidex = "native",
    deps = [":vanpilot_lib"],
)

# ============================================================================
# Release signing
#
# Signs the APK with a release keystore provided via environment variables.
# Required env vars (set in your shell, NOT committed):
#   VANPILOT_RELEASE_KEYSTORE      — path to release .keystore file
#   VANPILOT_RELEASE_KEYSTORE_PASS — keystore password
#   VANPILOT_RELEASE_KEY_ALIAS     — key alias
#   VANPILOT_RELEASE_KEY_PASS      — key password
#
# Build: bazel build //android:vanpilot_release_apk
#   (env vars above must be set; pass via --action_env or your shell)
# ============================================================================

genrule(
    name = "vanpilot_release_apk",
    srcs = [":vanpilot.apk"],
    outs = ["vanpilot-release.apk"],
    cmd = "$(location //android/keystores:sign_release) $< $@",
    tools = ["//android/keystores:sign_release"],
    tags = ["no-cache", "manual"],
)

