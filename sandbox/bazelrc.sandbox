# Sandbox-specific: proxy CA trust for Bazel's JVM (BCR registry fetches)
startup --host_jvm_args=-Djavax.net.ssl.trustStore=/home/agent/.bazel-ssl/cacerts
startup --host_jvm_args=-Djavax.net.ssl.trustStorePassword=changeit

# Proxy CA trust for pip/Python repo rule fetches (rules_python whl_library)
common --repo_env=REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
common --repo_env=SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
common --repo_env=CURL_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
